{
  "name": "orfeo",
  "private": true,
  "description": "Orfeo — acompañante con IA local",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @orfeo/server start:dev",
    "chat": "pnpm build && pnpm --filter @orfeo/server chat",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "gmail:auth": "pnpm build && pnpm --filter @orfeo/server gmail:auth",
    "voice:setup": "pnpm build && pnpm --filter @orfeo/server voice:setup",
    "web": "pnpm --filter @orfeo/face-web dev",
    "voice:gpu": "docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d speaches",
    "voice:cpu": "docker compose up -d --force-recreate speaches"
  }
}
