# Copia este archivo como .env
PORT=3000

# Ollama corre en tu PC
OLLAMA_URL=http://localhost:11434
# Modelo principal (rápido, que quepa en la GPU). Descárgalo con: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
# Tamaño de contexto (tokens). Más grande = más memoria de la GPU.
OLLAMA_NUM_CTX=8192
# Temperatura: 0 = predecible, 1 = creativo
OLLAMA_TEMPERATURE=0.7
# Modelos que "piensan" antes de responder (qwen3, gemma4). false = más rápido, ideal para charlar.
OLLAMA_THINK=false
# Tiempo máximo de espera por respuesta (ms)
OLLAMA_TIMEOUT_MS=120000

# --- Memoria (fase 2) ---
MONGO_URI=mongodb://localhost:27018/orfeo
# Multilingüe (100+ idiomas), ~200 MB. Descárgalo con: ollama pull embeddinggemma
OLLAMA_EMBED_MODEL=embeddinggemma
MEMORY_TOP_K=3
# Súbelo si entran recuerdos irrelevantes, bájalo si no recuerda cosas relacionadas (mira los scores en el log)
MEMORY_MIN_SCORE=0.6
